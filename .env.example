# Copie para .env e preencha na sua máquina. Nunca suba o .env para o GitHub.
# Os agentes não podem ler este arquivo (bloqueio em .claude/settings.json).

# Google (GA4, Search Console, YouTube, Ads)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_IDS=
GSC_SITE_URLS=
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta (Instagram Graph; o Meta Ads MCP remoto usa login, sem variável)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_IDS=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADVERTISER_IDS=

ALLOWLIST_FILE=config/allowlist.json

